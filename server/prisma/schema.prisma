// Схема БД (этап 1). API-сервер на Express + Prisma + SQLite подключается на этапе 4.
// Вложенные структуры (стиль барабана, цвета темы, заливка сектора) хранятся как JSON-строки:
// SQLite не поддерживает тип Json в Prisma, а сами структуры описаны в src/types/game.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // file:./dev.db
}

model Wheel {
  id          String     @id @default(cuid())
  name        String
  description String?
  styleJson   String // WheelStyle
  physicsJson String // SpinPhysics
  sections    Section[]
  questions   Question[]
  games       Game[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Section {
  id         String  @id @default(cuid())
  wheelId    String
  wheel      Wheel   @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  position   Int // порядок по часовой стрелке от стрелки
  type       String // SectionType: points | prize | bankrupt | plus | skip | multiplier | mystery
  label      String
  value      Int?
  prizeName  String?
  fillJson   String // SectionFill
  textColor  String?
  imageJson  String? // SectionImage
  weight     Float   @default(1)
  questionId String?

  @@index([wheelId, position])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  themeId     String?
  theme       Theme?     @relation(fields: [themeId], references: [id], onDelete: SetNull)
  questions   Question[]
}

model Question {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answer     String
  prompt     String
  hint       String?
  image      String?
  audio      String?
  difficulty String   @default("medium") // easy | medium | hard
  wheelId    String?
  wheel      Wheel?   @relation(fields: [wheelId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Theme {
  id             String     @id @default(cuid())
  name           String
  preset         Boolean    @default(false)
  // Theme без id/name/preset целиком: colors, fonts, background, wheelStyle, palette, sounds
  configJson     String
  categories     Category[]
  games          Game[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Game {
  id           String   @id @default(cuid())
  wheelId      String
  wheel        Wheel    @relation(fields: [wheelId], references: [id])
  themeId      String
  theme        Theme    @relation(fields: [themeId], references: [id])
  settingsJson String // GameSettings
  stateJson    String? // GameState — снапшот текущей партии (режим ведущего)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Asset {
  id        String   @id @default(cuid())
  kind      String // image | audio | background
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  tags      String   @default("") // через запятую
  createdAt DateTime @default(now())
}
